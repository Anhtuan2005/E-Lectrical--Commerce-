@model EcommerceApp.Models.ViewModels.BuildPcViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Smart PC Builder";
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var isAdminViewer = User.IsInRole("Admin");
}

@functions {
    private static string GetSlotIcon(string slot) => slot switch
    {
        "CPU" => "cpu",
        "VGA" => "monitor-up",
        "RAM" => "memory-stick",
        "SSD" => "hard-drive",
        "Mainboard" => "circuit-board",
        "PSU" => "zap",
        "Case" => "box",
        "Cooling" => "fan",
        _ => "settings"
    };

    private static string GetSlotLabel(string slot) => slot switch
    {
        "CPU" => "CPU",
        "VGA" => "Card đồ họa",
        "RAM" => "RAM",
        "SSD" => "Ổ cứng SSD",
        "Mainboard" => "Mainboard",
        "PSU" => "Nguồn",
        "Case" => "Vỏ case",
        "Cooling" => "Tản nhiệt",
        _ => slot
    };
}

<section class="buildpc-hero smartpc-hero section">
    <div class="buildpc-hero-inner smartpc-hero-inner">
        <div class="smartpc-hero-copy">
            <span class="eyebrow">Smart PC Builder</span>
            <h1>Dựng cấu hình PC theo ngân sách</h1>
            <p>Chọn mục tiêu, nhập ngân sách và để Techvora gợi ý bộ linh kiện cân bằng từ sản phẩm còn hàng.</p>
        </div>

        <form class="smart-builder-panel" id="smartBuildForm">
            <div class="smart-goal-grid" role="group" aria-label="Mục tiêu build PC">
                @foreach (var item in Model.Goals.Select((goal, index) => new { Goal = goal, Index = index }))
                {
                    <button class="smart-goal @(item.Index == 0 ? "is-active" : "")"
                            type="button"
                            data-smart-goal="@item.Goal.Key"
                            data-budget="@item.Goal.SuggestedBudget"
                            aria-pressed="@(item.Index == 0 ? "true" : "false")">
                        <i data-lucide="@item.Goal.Icon" aria-hidden="true"></i>
                        <span>@item.Goal.Label</span>
                        <small>@item.Goal.Description</small>
                    </button>
                }
            </div>

            <div class="smart-field-grid">
                <label class="smart-field">
                    <span>Ngân sách</span>
                    <input id="smartBudget" type="number" min="12000000" max="120000000" step="500000" value="28000000" inputmode="numeric" />
                </label>
                <label class="smart-field">
                    <span>Yêu cầu thêm</span>
                    <input id="smartNote" type="text" maxlength="180" placeholder="VD: case nhỏ, máy êm, ưu tiên RTX" autocomplete="off" />
                </label>
            </div>

            <button class="btn-primary smart-generate-btn" id="smartGenerate" type="submit">
                <i data-lucide="sparkles" aria-hidden="true"></i>
                Tạo cấu hình thông minh
            </button>
        </form>
    </div>
</section>

<section class="smart-result-section section reveal" id="smartResult" hidden>
    <div class="smart-result-head">
        <div>
            <span class="eyebrow">Trợ lý cấu hình</span>
            <h2 id="smartResultTitle">Cấu hình gợi ý</h2>
        </div>
        <div class="smart-result-total">
            <span>Tổng cấu hình</span>
            <strong id="smartResultTotal">0 ₫</strong>
            <small id="smartResultDelta">Đang chờ dữ liệu</small>
        </div>
    </div>

    <div class="smart-variant-tabs" id="smartVariantTabs" role="tablist" aria-label="So sánh cấu hình"></div>

    <div class="smart-score-grid" aria-label="Điểm tư vấn">
        <div class="smart-score">
            <span>Hiệu năng</span>
            <strong id="smartPerformanceScore">0</strong>
            <em><b id="smartPerformanceBar"></b></em>
        </div>
        <div class="smart-score">
            <span>Cân bằng</span>
            <strong id="smartBalanceScore">0</strong>
            <em><b id="smartBalanceBar"></b></em>
        </div>
        <div class="smart-score">
            <span>Nâng cấp</span>
            <strong id="smartUpgradeScore">0</strong>
            <em><b id="smartUpgradeBar"></b></em>
        </div>
        <div class="smart-score">
            <span>Giá trị</span>
            <strong id="smartValueScore">0</strong>
            <em><b id="smartValueBar"></b></em>
        </div>
    </div>

    <div class="smart-result-layout">
        <div class="smart-slot-grid" id="smartResultSlots"></div>

        <aside class="ai-advisor-panel">
            <div class="ai-advisor-head">
                <i data-lucide="bot" aria-hidden="true"></i>
                <div>
                    <span>Advisor notes</span>
                    <strong>Nhận định nhanh</strong>
                </div>
            </div>
            <ul class="ai-advisor-list" id="smartInsights"></ul>
            <div class="compat-check-panel">
                <div class="compat-check-title">
                    <i data-lucide="shield-check" aria-hidden="true"></i>
                    <strong>Kiểm tra tương thích</strong>
                </div>
                <div class="compat-check-list" id="smartCompatibility"></div>
            </div>
            <div class="ai-warning-list" id="smartWarnings"></div>
            <button class="btn-ghost smart-apply-btn" id="smartApplyBuild" type="button">
                <i data-lucide="list-checks" aria-hidden="true"></i>
                Áp dụng lại cấu hình này
            </button>
        </aside>
    </div>
</section>

<section class="builder-section section reveal">
    <div class="builder-head">
        <div>
            <span class="eyebrow">Tinh chỉnh</span>
            <h2>Cấu hình đang chọn</h2>
        </div>
        <p>Thay linh kiện theo ý bạn, Trợ lý cấu hình vẫn giữ cảnh báo ngân sách, công suất và tương thích cơ bản.</p>
    </div>

    <div class="builder-wrap">
        <div class="slot-list" id="slotList">
            @foreach (var slot in EcommerceApp.Models.PcSlots.All)
            {
                <div class="slot-row" data-slot="@slot">
                    <div class="slot-icon"><i data-lucide="@GetSlotIcon(slot)" aria-hidden="true"></i></div>
                    <div class="slot-info">
                        <span class="slot-name">@GetSlotLabel(slot)</span>
                        <span class="slot-selected-name">Chưa chọn</span>
                    </div>
                    <div class="slot-price-display">-</div>
                    <button class="btn-ghost slot-choose-btn" type="button" data-choose="@slot">Chọn</button>
                    <button class="btn-icon slot-clear-btn" type="button" data-clear="@slot" aria-label="Xóa @GetSlotLabel(slot)" hidden>
                        <i data-lucide="x" aria-hidden="true"></i>
                    </button>
                </div>
            }
        </div>

        <aside class="build-summary" id="buildSummary">
            <h3>Cấu hình</h3>
            <ul class="summary-list" id="summaryList">
                <li class="summary-empty">Chưa chọn linh kiện nào</li>
            </ul>
            <div class="summary-total">
                <span>Tổng cộng</span>
                <strong id="buildTotal">0 ₫</strong>
            </div>
            <div class="compat-warnings" id="compatWarnings"></div>
            <div class="wattage-info" id="wattageInfo" hidden>
                <span>Công suất ước tính: <strong id="wattageVal">-</strong> W</span>
            </div>
            <div class="summary-advisor">
                <div>
                    <i data-lucide="bot" aria-hidden="true"></i>
                    <strong>Trợ lý cấu hình</strong>
                </div>
                <p id="summaryAdvisorText">Tạo cấu hình thông minh để nhận đánh giá nhanh.</p>
            </div>
            @if (isAdminViewer)
            {
                <div class="admin-view-note">
                    <strong>Chế độ xem admin</strong>
                    <span>Có thể kiểm tra cấu hình, nhưng không thêm vào giỏ.</span>
                </div>
            }
            else
            {
                <button class="btn-primary btn-add-all" id="btnAddAll" type="button" disabled>Thêm tất cả vào giỏ</button>
            }
            <button class="btn-ghost btn-reset-build" id="btnReset" type="button">
                <i data-lucide="rotate-ccw" aria-hidden="true"></i>
                Đặt lại
            </button>
        </aside>
    </div>
</section>

<div class="modal-overlay buildpc-modal" id="slotModal" role="dialog" aria-modal="true" aria-label="Chọn linh kiện" hidden>
    <div class="modal-panel">
        <div class="modal-head">
            <h3 id="modalTitle">Chọn linh kiện</h3>
            <button class="modal-close" type="button" id="modalClose" aria-label="Đóng">
                <i data-lucide="x" aria-hidden="true"></i>
            </button>
        </div>
        <div class="modal-search">
            <input type="text" id="modalSearch" placeholder="Tìm kiếm trong slot này..." autocomplete="off" />
        </div>
        <div class="modal-product-list" id="modalProductList"></div>
    </div>
</div>

@section Scripts {
    <script>
        window.SMART_GOALS = @Html.Raw(JsonSerializer.Serialize(Model.Goals, jsonOptions));
        window.SLOT_PRODUCTS = @Html.Raw(JsonSerializer.Serialize(
            Model.SlotProducts.ToDictionary(
                slot => slot.Key,
                slot => slot.Value.Select(product => new {
                    id = product.Id,
                    name = product.Name,
                    priceRaw = (long)product.SalePrice,
                    price = product.SalePrice.ToString("N0") + " ₫",
                    imageUrl = product.PrimaryImageUrl,
                    category = product.Category?.Name,
                    stock = product.Stock,
                    url = Url.Action("Detail", "Product", new { id = product.Id })
                })
            ),
            jsonOptions
        ));
    </script>
    <script src="~/js/buildpc.js" asp-append-version="true"></script>
}
