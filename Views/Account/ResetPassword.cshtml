@model ResetPasswordViewModel
@{
    Layout = "_FocusLayout";
    ViewData["Title"] = "Đặt lại mật khẩu";
    ViewData["BodyClass"] = "password-reset-focus";
}

<main class="password-reset-page">
    <section class="password-reset-card">
        <a class="password-reset-logo auth-brand-home" asp-controller="Home" asp-action="Index" aria-label="Về trang chủ Techvora">
            <partial name="_TechvoraLogo" />
        </a>

        <div class="password-reset-copy">
            <span class="eyebrow">Bảo mật tài khoản</span>
            <h1>Đặt lại mật khẩu</h1>
            <p>Nhập mật khẩu mới cho tài khoản của bạn.</p>
        </div>

        <form asp-action="ResetPassword" method="post" class="password-reset-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Token" />
            <div asp-validation-summary="ModelOnly" class="alert-error"></div>

            <div class="field-group">
                <label asp-for="NewPassword">Mật khẩu mới</label>
                <div class="input-wrap">
                    <i data-lucide="lock" class="input-icon" aria-hidden="true"></i>
                    <input asp-for="NewPassword" type="password" autocomplete="new-password" placeholder="Ít nhất 6 ký tự" />
                </div>
                <span asp-validation-for="NewPassword" class="field-error"></span>
            </div>

            <div class="field-group">
                <label asp-for="ConfirmPassword">Nhập lại mật khẩu</label>
                <div class="input-wrap">
                    <i data-lucide="lock" class="input-icon" aria-hidden="true"></i>
                    <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" placeholder="Nhập lại mật khẩu mới" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>

            <button class="btn-auth-submit" type="submit">Đặt lại mật khẩu</button>
        </form>

        <a asp-action="Login" class="password-reset-back">
            <i data-lucide="arrow-left" aria-hidden="true"></i>
            Quay lại đăng nhập
        </a>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
