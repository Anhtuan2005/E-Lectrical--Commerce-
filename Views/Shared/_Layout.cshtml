@inject IConfiguration Configuration
@{
    var viewTitle = ViewData["Title"]?.ToString();
    var pageTitle = string.IsNullOrWhiteSpace(viewTitle) ? "Techvora" : $"Techvora - {viewTitle}";
    var metaDescription = ViewData["MetaDescription"]?.ToString()
        ?? Configuration["Seo:DefaultDescription"]
        ?? "Techvora - cửa hàng công nghệ dành cho điện thoại, laptop, linh kiện PC và phụ kiện.";
    var configuredBaseUrl = Configuration["Seo:BaseUrl"]?.Trim();
    var requestBaseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}";
    var siteBaseUrl = string.IsNullOrWhiteSpace(configuredBaseUrl) ? requestBaseUrl : configuredBaseUrl;
    siteBaseUrl = siteBaseUrl.TrimEnd('/');
    var canonicalPath = ViewData["CanonicalPath"]?.ToString() ?? Context.Request.Path.Value ?? "/";
    var canonicalUrl = Uri.TryCreate(canonicalPath, UriKind.Absolute, out var absoluteCanonical)
        ? absoluteCanonical.AbsoluteUri
        : $"{siteBaseUrl}/{canonicalPath.TrimStart('/')}";
    var ogImageValue = ViewData["OgImage"]?.ToString()
        ?? Configuration["Seo:DefaultImage"]
        ?? "/images/techvora-favicon.svg";
    var ogImageUrl = Uri.TryCreate(ogImageValue, UriKind.Absolute, out var absoluteImage)
        ? absoluteImage.AbsoluteUri
        : $"{siteBaseUrl}/{ogImageValue.TrimStart('/')}";
    var ogType = ViewData["OgType"]?.ToString() ?? "website";
    var ogTitle = ViewData["OgTitle"]?.ToString() ?? pageTitle;
    var ogDescription = ViewData["OgDescription"]?.ToString() ?? metaDescription;
    var ogSiteName = ViewData["OgSiteName"]?.ToString()
        ?? Configuration["Seo:SiteName"]
        ?? "Techvora";
    var ogImageAlt = ViewData["OgImageAlt"]?.ToString() ?? ogTitle;
    var productPriceAmount = ViewData["ProductPriceAmount"]?.ToString();
    var productPriceCurrency = ViewData["ProductPriceCurrency"]?.ToString();
    var privatePrefixes = new[]
    {
        "/Admin", "/Account", "/Cart", "/Order", "/Payment",
        "/Notification", "/Wishlist", "/ReturnWarranty"
    };
    var defaultRobots = privatePrefixes.Any(prefix =>
        Context.Request.Path.StartsWithSegments(prefix, StringComparison.OrdinalIgnoreCase))
        ? "noindex,nofollow"
        : "index,follow";
    var robots = ViewData["Robots"]?.ToString() ?? defaultRobots;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    <meta name="description" content="@metaDescription" />
    <meta name="robots" content="@robots" />
    <link rel="canonical" href="@canonicalUrl" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content="@ogSiteName" />
    <meta property="og:type" content="@ogType" />
    <meta property="og:title" content="@ogTitle" />
    <meta property="og:description" content="@ogDescription" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:image" content="@ogImageUrl" />
    <meta property="og:image:secure_url" content="@ogImageUrl" />
    <meta property="og:image:alt" content="@ogImageAlt" />
    @if (!string.IsNullOrWhiteSpace(productPriceAmount))
    {
        <meta property="product:price:amount" content="@productPriceAmount" />
    }
    @if (!string.IsNullOrWhiteSpace(productPriceCurrency))
    {
        <meta property="product:price:currency" content="@productPriceCurrency" />
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@ogTitle" />
    <meta name="twitter:description" content="@ogDescription" />
    <meta name="twitter:image" content="@ogImageUrl" />
    <meta name="twitter:image:alt" content="@ogImageAlt" />
    <link rel="icon" href="~/images/techvora-favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js" defer></script>
    <script type="importmap">
        {
          "imports": {
            "three": "https://unpkg.com/three@0.158.0/build/three.module.js",
            "three/addons/": "https://unpkg.com/three@0.158.0/examples/jsm/"
          }
        }
    </script>
    <environment include="Development">
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/site.min.css" asp-append-version="true" />
    </environment>
</head>
<body>
    <header>
        <partial name="_Navbar" />
    </header>
    @Html.AntiForgeryToken()
    <div class="toast-stack" id="toast-stack">
        @if (TempData["Success"] is string success)
        {
            <div class="toast toast-success">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="toast toast-error">@error</div>
        }
        @if (TempData["PaymentResult"] is string paymentResult)
        {
            <div class="toast toast-success">@paymentResult</div>
        }
    </div>
    <main role="main">
        @RenderBody()
    </main>
    <partial name="_CompareTray" />
    <div class="cart-offer-modal" id="cartOfferModal" hidden aria-hidden="true">
        <div class="cart-offer-backdrop" data-cart-offer-close></div>
        <section class="cart-offer-dialog" role="dialog" aria-modal="true" aria-labelledby="cartOfferTitle">
            <button class="cart-offer-close" type="button" data-cart-offer-close aria-label="Đóng">
                <i data-lucide="x" aria-hidden="true"></i>
            </button>
            <div class="cart-offer-head">
                <span>Đã thêm vào giỏ</span>
                <h2 id="cartOfferTitle">Gợi ý mua kèm phù hợp</h2>
                <p>Chọn thêm sản phẩm thường được mua cùng hoặc đang có giá mua kèm.</p>
            </div>
            <div class="cart-offer-list" id="cartOfferList"></div>
            <div class="cart-offer-actions">
                <a class="btn-ghost" asp-controller="Cart" asp-action="Index">Xem giỏ</a>
                @if (!User.IsInRole("Admin"))
                {
                    <a class="btn-primary" asp-controller="Cart" asp-action="Index">Thanh toán trong giỏ</a>
                }
            </div>
        </section>
    </div>
    <partial name="_AiChatbot" />
    <footer class="site-footer">
        <div class="footer-grid">
            <div class="footer-brand">
                <partial name="_TechvoraLogo" />
                <p>Năng lượng cho mọi thiết bị. Techvora chọn lọc điện thoại, laptop và phụ kiện công nghệ với trải nghiệm mua sắm nhanh, rõ, an toàn.</p>
                <div class="social-row">
                    <a href="https://www.facebook.com/" target="_blank" rel="noopener" aria-label="Facebook">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8.6h2.4V5.1c-.4-.1-1.8-.2-3.3-.2-3.3 0-5.5 2-5.5 5.7v3.2H4v3.9h3.6V24h4.3v-6.3h3.5l.6-3.9h-4.1V11c0-1.1.3-2.4 2.1-2.4Z"/></svg>
                    </a>
                    <a href="https://www.instagram.com/" target="_blank" rel="noopener" aria-label="Instagram">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="5" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="3.6" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="16.9" cy="7.1" r="1.1"/></svg>
                    </a>
                    <a href="https://zalo.me/0900000000" target="_blank" rel="noopener" aria-label="Zalo">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.5 5.2h13a2.3 2.3 0 0 1 2.3 2.3v6.8a2.3 2.3 0 0 1-2.3 2.3h-6.2l-4.4 3v-3H5.5a2.3 2.3 0 0 1-2.3-2.3V7.5a2.3 2.3 0 0 1 2.3-2.3Z" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M7.1 13.5 10 9.9H7.3V8.4h5.1l-2.9 3.7h3v1.4H7.1Zm7.1-5.1h1.5v5.1h-1.5V8.4Zm3.1 2.6a1.4 1.4 0 1 1-2.8 0 1.4 1.4 0 0 1 2.8 0Z" fill="currentColor"/></svg>
                    </a>
                </div>
            </div>
            <div>
                <h3>Thông tin</h3>
                <a asp-controller="Info" asp-action="About">Về Techvora</a>
                <a asp-controller="Info" asp-action="Privacy">Chính sách bảo mật</a>
                <a asp-controller="Info" asp-action="Terms">Điều khoản</a>
                <a asp-controller="Info" asp-action="Careers">Tuyển dụng</a>
            </div>
            <div>
                <h3>Hỗ trợ</h3>
                <a asp-controller="Info" asp-action="BuyingGuide">Hướng dẫn mua hàng</a>
                <a asp-controller="Info" asp-action="Returns">Chính sách đổi trả</a>
                <a asp-controller="Info" asp-action="Warranty">Bảo hành</a>
                <a asp-controller="Info" asp-action="Faq">FAQ</a>
            </div>
            <div>
                <h3>Liên hệ</h3>
                <p>72 Lê Lợi, Quận 1, TP. Hồ Chí Minh</p>
                <p><a href="tel:0900000000">0900 000 000</a></p>
                <p><a href="mailto:hello@techvora.vn">hello@techvora.vn</a></p>
                <form class="newsletter-form">
                    <input type="email" placeholder="Email nhận tin" aria-label="Email nhận tin" />
                    <button type="button">Gửi</button>
                </form>
            </div>
        </div>
        <div class="footer-bottom">
            <span>© @DateTime.Now.Year Techvora. Tất cả quyền được bảo lưu.</span>
            <div class="payment-row">
                <span>COD</span>
                <span>Banking</span>
                <svg class="payment-vnpay" viewBox="0 0 92 28" role="img" aria-label="VNPay"><rect width="92" height="28" rx="8"/><path d="M14 9h9l-4.7 10H9.6L14 9Z"/><text x="30" y="19" font-size="13" font-family="Inter, Arial" font-weight="800">VNPay</text></svg>
            </div>
        </div>
    </footer>
    <environment include="Development">
        <script src="~/js/site.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/site.min.js" asp-append-version="true"></script>
    </environment>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
