@model ProductViewModel
@{
    ViewData["Title"] = "Sản phẩm";
    var selectedCategory = Model.Categories.FirstOrDefault(category => category.Id == Model.CategoryId);
    var hasPriceFilter = Model.MinPrice.HasValue || Model.MaxPrice.HasValue;
    var activeFilterCount = (Model.CategoryId.HasValue ? 1 : 0) + (hasPriceFilter ? 1 : 0);
    Func<decimal, string> compactPrice = value =>
        value >= 1_000_000m ? $"{value / 1_000_000m:0.#}tr" :
        value >= 1_000m ? $"{value / 1_000m:0.#}k" :
        value.ToString("N0");
    var priceFilterLabel = Model.MinPrice.HasValue && Model.MaxPrice.HasValue
        ? $"Giá: {compactPrice(Model.MinPrice.Value)}-{compactPrice(Model.MaxPrice.Value)}"
        : Model.MinPrice.HasValue
            ? $"Giá từ {compactPrice(Model.MinPrice.Value)}"
            : Model.MaxPrice.HasValue
                ? $"Giá đến {compactPrice(Model.MaxPrice.Value)}"
                : string.Empty;
}

<section class="page-head product-page-head">
    <div>
        <span class="eyebrow">Techvora Store</span>
        <h1>Tìm thiết bị phù hợp</h1>
        <p><strong>@Model.TotalItems sản phẩm</strong> để bạn tìm và so sánh.</p>
    </div>
</section>

<section class="product-catalog catalog-compact" data-catalog-filters>
    <div class="catalog-toolbar">
        <div class="catalog-toolbar-top">
            <form class="catalog-search" method="get" role="search">
                <button class="catalog-search-icon" type="submit" aria-label="Tìm kiếm">
                    <i data-lucide="search" aria-hidden="true"></i>
                </button>
                <input name="search" value="@Model.Search" placeholder="Tìm theo tên sản phẩm..." aria-label="Tìm kiếm sản phẩm" />
                <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                <input type="hidden" name="minPrice" value="@Model.MinPrice" />
                <input type="hidden" name="maxPrice" value="@Model.MaxPrice" />
                <input type="hidden" name="sortBy" value="@Model.SortBy" />
                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <a class="catalog-search-clear"
                       asp-action="Index"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-minPrice="@Model.MinPrice"
                       asp-route-maxPrice="@Model.MaxPrice"
                       asp-route-sortBy="@Model.SortBy"
                       aria-label="Xóa từ khóa tìm kiếm">
                        <i data-lucide="x" aria-hidden="true"></i>
                    </a>
                }
            </form>

            <button class="catalog-filter-toggle" type="button" data-catalog-filter-toggle aria-expanded="false" aria-controls="catalogFilterPanel">
                <i data-lucide="sliders-horizontal" aria-hidden="true"></i>
                <span>Bộ lọc</span>
                @if (activeFilterCount > 0)
                {
                    <em>@activeFilterCount</em>
                }
            </button>
        </div>

        <div class="catalog-toolbar-controls">
            <div class="catalog-sort" aria-label="Sắp xếp sản phẩm">
                <span class="catalog-sort-label">Sắp xếp:</span>
                <div class="catalog-sort-options">
                    <a class="@(Model.SortBy == "featured" ? "active" : "")"
                       asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-minPrice="@Model.MinPrice"
                       asp-route-maxPrice="@Model.MaxPrice"
                       asp-route-sortBy="featured">
                        <i data-lucide="star" aria-hidden="true"></i>
                        <span>Nổi bật</span>
                    </a>
                    <a class="@(Model.SortBy == "best_selling" ? "active" : "")"
                       asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-minPrice="@Model.MinPrice"
                       asp-route-maxPrice="@Model.MaxPrice"
                       asp-route-sortBy="@(Model.SortBy == "best_selling" ? "featured" : "best_selling")">
                        <i data-lucide="trending-up" aria-hidden="true"></i>
                        <span>Bán chạy</span>
                        @if (Model.SortBy == "best_selling")
                        {
                            <i data-lucide="x" aria-hidden="true"></i>
                        }
                    </a>
                    <a class="@(Model.SortBy == "discount_desc" ? "active" : "")"
                       asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-minPrice="@Model.MinPrice"
                       asp-route-maxPrice="@Model.MaxPrice"
                       asp-route-sortBy="@(Model.SortBy == "discount_desc" ? "featured" : "discount_desc")">
                        <i data-lucide="tag" aria-hidden="true"></i>
                        <span>Giảm giá</span>
                        @if (Model.SortBy == "discount_desc")
                        {
                            <i data-lucide="x" aria-hidden="true"></i>
                        }
                    </a>
                    <a class="@(Model.SortBy == "newest" ? "active" : "")"
                       asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-minPrice="@Model.MinPrice"
                       asp-route-maxPrice="@Model.MaxPrice"
                       asp-route-sortBy="@(Model.SortBy == "newest" ? "featured" : "newest")">
                        <i data-lucide="sparkles" aria-hidden="true"></i>
                        <span>Mới nhất</span>
                        @if (Model.SortBy == "newest")
                        {
                            <i data-lucide="x" aria-hidden="true"></i>
                        }
                    </a>
                </div>
            </div>

            <div class="catalog-view-tools">
                <form method="get" class="catalog-price-sort">
                    <input type="hidden" name="search" value="@Model.Search" />
                    <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                    <input type="hidden" name="minPrice" value="@Model.MinPrice" />
                    <input type="hidden" name="maxPrice" value="@Model.MaxPrice" />
                    <label class="visually-hidden" for="catalogPriceSort">Sắp xếp theo giá</label>
                    <select id="catalogPriceSort" name="sortBy" onchange="this.form.submit()">
                        <option value="featured" selected="@(Model.SortBy != "price_asc" && Model.SortBy != "price_desc")">Sắp xếp theo giá</option>
                        <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Giá: thấp → cao</option>
                        <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Giá: cao → thấp</option>
                    </select>
                </form>
                <div class="catalog-layout-toggle" aria-label="Kiểu hiển thị">
                    <button class="active" type="button" data-catalog-layout="grid" aria-label="Hiển thị dạng lưới" aria-pressed="true">
                        <i data-lucide="grid-2x2" aria-hidden="true"></i>
                    </button>
                    <button type="button" data-catalog-layout="list" aria-label="Hiển thị dạng danh sách" aria-pressed="false">
                        <i data-lucide="list" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </div>

        @if (activeFilterCount > 0)
        {
            <div class="catalog-filter-tags">
                @if (selectedCategory is not null)
                {
                    <a asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-route-minPrice="@Model.MinPrice"
                       asp-route-maxPrice="@Model.MaxPrice"
                       asp-route-sortBy="@Model.SortBy">
                        <span>Danh mục: @selectedCategory.Name</span>
                        <i data-lucide="x" aria-hidden="true"></i>
                    </a>
                }
                @if (hasPriceFilter)
                {
                    <a asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-sortBy="@Model.SortBy">
                        <span>@priceFilterLabel</span>
                        <i data-lucide="x" aria-hidden="true"></i>
                    </a>
                }
                <a class="clear-all" asp-action="Index" asp-route-search="@Model.Search" asp-route-sortBy="@Model.SortBy">Xóa tất cả</a>
            </div>
        }
    </div>

    <aside class="catalog-sidebar catalog-filter-panel" id="catalogFilterPanel" hidden>
        <form method="get" class="catalog-filter">
            <input type="hidden" name="search" value="@Model.Search" />
            <input type="hidden" name="sortBy" value="@Model.SortBy" />
            <div class="filter-title-row">
                <h2>Bộ lọc sản phẩm</h2>
                <a asp-action="Index" asp-route-search="@Model.Search" asp-route-sortBy="@Model.SortBy">Xóa lọc</a>
            </div>
            <div class="filter-group category-filter-group">
                <div class="filter-group-head">
                    <strong>Danh mục</strong>
                    <span>@Model.Categories.Count()</span>
                </div>
                <div class="category-filter-grid">
                    <label class="filter-check">
                        <input type="radio" name="categoryId" value="" checked="@(!Model.CategoryId.HasValue)" />
                        <span>Tất cả</span>
                    </label>
                    @foreach (var category in Model.Categories)
                    {
                        <label class="filter-check">
                            <input type="radio" name="categoryId" value="@category.Id" checked="@(Model.CategoryId == category.Id)" />
                            <span>@category.Name</span>
                        </label>
                    }
                </div>
            </div>
            <div class="filter-group">
                <div class="filter-group-head">
                    <strong>Khoảng giá</strong>
                    <span>VNĐ</span>
                </div>
                <div class="price-filter-grid">
                    <label>
                        <span>Từ</span>
                        <input name="minPrice" type="number" min="0" step="100000" value="@Model.MinPrice" placeholder="0" />
                    </label>
                    <label>
                        <span>Đến</span>
                        <input name="maxPrice" type="number" min="0" step="100000" value="@Model.MaxPrice" placeholder="Không giới hạn" />
                    </label>
                </div>
            </div>
            <button class="btn-primary catalog-filter-submit" type="submit">
                <i data-lucide="sliders-horizontal" aria-hidden="true"></i>
                Áp dụng bộ lọc
            </button>
        </form>
    </aside>

    <div class="catalog-results">
        <div class="product-grid">
            @if (!Model.Products.Any())
            {
                <div class="empty-state catalog-empty-state">
                    <strong>Không tìm thấy sản phẩm phù hợp</strong>
                    <span>Thử nới khoảng giá hoặc chọn danh mục khác.</span>
                    <a class="btn-secondary" asp-action="Index" asp-route-search="@Model.Search" asp-route-sortBy="@Model.SortBy">Xóa bộ lọc</a>
                </div>
            }
            else
            {
                @foreach (var product in Model.Products)
                {
                    <partial name="_ProductCard" model="product" />
                }
            }
        </div>

        <nav class="pagination">
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <a class="@(i == Model.CurrentPage ? "active" : "")" asp-action="Index" asp-route-page="@i" asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-sortBy="@Model.SortBy">@i</a>
            }
        </nav>
    </div>
</section>
