@{
    Layout = "_FocusLayout";
    ViewData["Title"] = "Kiểm tra email";
    ViewData["BodyClass"] = "password-reset-focus";
}

<main class="password-reset-page">
    <section class="password-reset-card password-reset-confirmation">
        <a class="password-reset-logo auth-brand-home" asp-controller="Home" asp-action="Index" aria-label="Về trang chủ Techvora">
            <partial name="_TechvoraLogo" />
        </a>

        <div class="password-reset-confirmation-icon" aria-hidden="true">
            <i data-lucide="mail-check"></i>
        </div>

        <div class="password-reset-copy">
            <span class="eyebrow">Yêu cầu đã được ghi nhận</span>
            <h1>Kiểm tra hộp thư</h1>
            <p>Nếu email khớp với tài khoản Techvora, hướng dẫn đặt lại mật khẩu sẽ được gửi đến hộp thư đó.</p>
        </div>

        <div class="password-reset-notice">
            <i data-lucide="clock-3" aria-hidden="true"></i>
            <span>Liên kết có hiệu lực trong 30 phút. Kiểm tra cả thư rác nếu chưa thấy email.</span>
        </div>

        <div class="password-reset-confirmation-actions">
            <a class="btn-auth-submit" asp-action="Login">Về trang đăng nhập</a>
            <a class="password-reset-back" asp-action="ForgotPassword">
                <i data-lucide="rotate-ccw" aria-hidden="true"></i>
                Gửi lại hướng dẫn
            </a>
        </div>
    </section>
</main>
