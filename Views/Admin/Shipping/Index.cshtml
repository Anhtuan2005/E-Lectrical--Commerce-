@model ShippingDashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý vận chuyển";
    var statuses = ViewBag.Statuses as IEnumerable<string> ?? ShippingStatuses.All;
}

<section class="metric-grid">
    <article><span>Thiếu mã vận đơn</span><strong>@Model.MissingTrackingCount</strong></article>
    <article><span>Đơn chậm trễ</span><strong>@Model.DelayedCount</strong></article>
    @foreach (var status in ShippingStatuses.All)
    {
        <article><span>@status</span><strong>@Model.OrdersByShippingStatus.GetValueOrDefault(status)</strong></article>
    }
</section>

<section class="admin-panel">
    <div class="panel-head"><h2>Đơn cần xử lý</h2></div>
    <table class="admin-table admin-shipping-table">
        <thead><tr><th>Mã</th><th>Khách hàng</th><th>Trạng thái đơn</th><th>Vận chuyển</th><th>Mã vận đơn</th><th>Trạng thái giao</th></tr></thead>
        <tbody>
            @foreach (var order in Model.ActionNeededOrders)
            {
                <tr>
                    <td>#@order.Id</td>
                    <td>@order.User?.FullName</td>
                    <td>@order.Status</td>
                    <td>
                        <strong>@(string.IsNullOrWhiteSpace(order.ShippingInfo?.Carrier) ? "Chưa gán" : order.ShippingInfo.Carrier)</strong><br />
                        <small>@(string.IsNullOrWhiteSpace(order.ShippingInfo?.TrackingCode) ? "Chưa có mã" : order.ShippingInfo.TrackingCode)</small>
                    </td>
                    <td>
                        <form action="/Admin/Shipping/UpdateTracking" method="post" class="inline-tracking-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="orderId" value="@order.Id" />
                            <input name="carrier" value="@order.ShippingInfo?.Carrier" placeholder="Đơn vị vận chuyển" aria-label="Đơn vị vận chuyển cho đơn #@order.Id" />
                            <input name="trackingCode" value="@order.ShippingInfo?.TrackingCode" placeholder="Nhập mã rồi Enter" aria-label="Mã vận đơn cho đơn #@order.Id" autocomplete="off" />
                            <button class="admin-button" type="submit">Lưu</button>
                        </form>
                    </td>
                    <td>
                        @if (order.ShippingInfo is not null)
                        {
                            <form action="/Admin/Shipping/UpdateStatus" method="post" class="inline-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="orderId" value="@order.Id" />
                                <select name="status">
                                    @foreach (var status in statuses)
                                    {
                                        <option value="@status" selected="@(order.ShippingInfo.Status == status)">@status</option>
                                    }
                                </select>
                                <button class="admin-button" type="submit">Lưu</button>
                            </form>
                        }
                        else
                        {
                            <span class="admin-pill off">Chưa gán</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>
