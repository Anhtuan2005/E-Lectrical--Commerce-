@model HomeViewModel
@{
    ViewData["Title"] = "Trang chủ";
    ViewData["MetaDescription"] = "Techvora chuyên điện thoại chính hãng với giá, thông số và tồn kho rõ ràng.";
    ViewData["CanonicalPath"] = Url.Action("Index", "Home");
    var configuredBanners = Model.Banners.ToList();
    var fallbackBanners = new[]
    {
        new Banner { Title = "iPhone chính hãng.\nChọn nhanh, đặt gọn.", Subtitle = "Xem giá, thông số và tồn kho rõ ràng trước khi đặt hàng.", LinkUrl = "/Product?search=iPhone", ButtonText = "Xem iPhone", ImageUrl = "https://images.pexels.com/photos/19800760/pexels-photo-19800760.jpeg?auto=compress&cs=tinysrgb&fit=crop&w=1800&h=680" },
        new Banner { Title = "Samsung Galaxy.\nSắc nét từng khoảnh khắc.", Subtitle = "Khám phá điện thoại Galaxy nổi bật cho công việc và giải trí.", LinkUrl = "/Product?search=Samsung", ButtonText = "Xem Samsung", ImageUrl = "https://images.pexels.com/photos/33975307/pexels-photo-33975307.jpeg?auto=compress&cs=tinysrgb&fit=crop&w=1800&h=680" },
        new Banner { Title = "Xiaomi linh hoạt.\nĐúng máy, đúng giá.", Subtitle = "Hiệu năng tốt, camera nổi bật và nhiều lựa chọn theo nhu cầu.", LinkUrl = "/Product?search=Xiaomi", ButtonText = "Xem Xiaomi", ImageUrl = "https://images.pexels.com/photos/10902946/pexels-photo-10902946.jpeg?auto=compress&cs=tinysrgb&fit=crop&w=1800&h=680" }
    };
    string BannerIdentity(Banner banner)
    {
        var content = $"{banner.Title} {banner.Subtitle}";
        if (content.Contains("iPhone", StringComparison.OrdinalIgnoreCase) || content.Contains("Apple", StringComparison.OrdinalIgnoreCase)) return "brand:apple";
        if (content.Contains("Samsung", StringComparison.OrdinalIgnoreCase) || content.Contains("Galaxy", StringComparison.OrdinalIgnoreCase)) return "brand:samsung";
        if (content.Contains("Xiaomi", StringComparison.OrdinalIgnoreCase) || content.Contains("Android", StringComparison.OrdinalIgnoreCase)) return "brand:xiaomi";

        var imageUrl = (banner.ImageUrl ?? string.Empty).Trim();
        if (Uri.TryCreate(imageUrl, UriKind.Absolute, out var uri))
        {
            return $"image:{uri.Host}{uri.AbsolutePath}".ToLowerInvariant();
        }

        return $"image:{imageUrl.Split('?', '#')[0]}".ToLowerInvariant();
    }
    IEnumerable<Banner> banners = configuredBanners
        .Concat(fallbackBanners)
        .Where(banner => !string.IsNullOrWhiteSpace(banner.ImageUrl))
        .GroupBy(BannerIdentity, StringComparer.OrdinalIgnoreCase)
        .Select(group => group.First())
        .Take(3);
    var flashProducts = Model.FlashSaleProducts.ToList();
    if (!flashProducts.Any())
    {
        flashProducts = Model.FeaturedProducts.Where(product => product.DiscountPercent > 0).Take(5).ToList();
    }
    var mainDeal = flashProducts.FirstOrDefault();
    var miniDeals = flashProducts.Skip(1).Take(4).ToList();
    var isAdminViewer = User.IsInRole("Admin");
    var visibleBannerCount = banners.Take(3).Count();
}

<section class="home-shell tv-home">
    <section class="hero-slider hero-premium reveal" id="heroSlider" aria-roledescription="carousel" aria-label="Điện thoại nổi bật">
        <div class="slider-track">
            @{ var bannerIndex = 0; }
            @foreach (var banner in banners.Take(3))
            {
                var bannerIdentity = BannerIdentity(banner);
                var bannerClass = bannerIdentity.StartsWith("brand:", StringComparison.OrdinalIgnoreCase)
                    ? bannerIdentity["brand:".Length..]
                    : "generic";
                <div class="slide slide-@bannerClass" role="group" aria-roledescription="slide" aria-label="@(bannerIndex + 1) / @visibleBannerCount" aria-hidden="@(bannerIndex == 0 ? "false" : "true")" inert="@(bannerIndex == 0 ? null : string.Empty)">
                    <div class="slide-bg">
                        <img src="@banner.ImageUrl"
                             alt="@banner.Title"
                             loading="@(bannerIndex == 0 ? "eager" : "lazy")"
                             decoding="async"
                             fetchpriority="@(bannerIndex == 0 ? "high" : "low")"
                             onerror="this.onerror=null;this.hidden=true;this.closest('.slide').classList.add('image-failed');" />
                    </div>
                    <div class="slide-content">
                        <p class="slide-eyebrow"><span></span> Techvora Signature</p>
                        <h1 class="slide-title">@banner.Title</h1>
                        <p class="slide-sub">@banner.Subtitle</p>
                        <div class="slide-actions">
                            <a href="@(string.IsNullOrWhiteSpace(banner.LinkUrl) ? "/Product" : banner.LinkUrl)" class="btn-primary">@banner.ButtonText</a>
                            <a href="/Product" class="btn-ghost">Xem bộ sưu tập</a>
                        </div>
                    </div>
                </div>
                bannerIndex++;
            }
        </div>
        <div class="slider-dots">
            @for (var i = 0; i < visibleBannerCount; i++)
            {
                <button class="dot @(i == 0 ? "active" : "")" data-index="@i" aria-label="Đi tới slide @(i + 1)" aria-current="@(i == 0 ? "true" : "false")"></button>
            }
        </div>
        <button class="slider-arrow slider-prev" type="button" aria-label="Slide trước"><i data-lucide="chevron-left" aria-hidden="true"></i></button>
        <button class="slider-arrow slider-next" type="button" aria-label="Slide sau"><i data-lucide="chevron-right" aria-hidden="true"></i></button>
    </section>

    <section class="usp-bar usp-premium reveal" tabindex="0" aria-label="Cam kết dịch vụ, cuộn ngang để xem thêm">
        <div class="usp-item"><span class="usp-icon"><i data-lucide="truck" aria-hidden="true"></i></span><div><strong>Giao nhanh toàn quốc</strong><p>Miễn phí từ <span class="usp-price">500.000&nbsp;₫</span></p></div></div>
        <div class="usp-item"><span class="usp-icon"><i data-lucide="badge-dollar-sign" aria-hidden="true"></i></span><div><strong>Giá và tồn kho rõ ràng</strong><p>Kiểm tra trước khi đặt hàng</p></div></div>
        <div class="usp-item"><span class="usp-icon"><i data-lucide="list-checks" aria-hidden="true"></i></span><div><strong>Thông số chi tiết</strong><p>Dễ xem và so sánh sản phẩm</p></div></div>
        <div class="usp-item"><span class="usp-icon"><i data-lucide="credit-card" aria-hidden="true"></i></span><div><strong>Thanh toán an toàn</strong><p>@(SprintFeatures.IsEnabled(2) ? "COD, Banking, VNPAY" : "Thanh toán khi nhận hàng (COD)")</p></div></div>
    </section>

    <section class="section reveal">
        <div class="section-heading tech-heading">
            <div>
                <span class="eyebrow">Thương hiệu điện thoại</span>
                <h2>Chọn theo thương hiệu</h2>
            </div>
            <a asp-controller="Product" asp-action="Index">Xem tất cả</a>
        </div>
        <div class="category-grid tech-category-grid">
            @foreach (var brand in Model.Brands.Take(8))
            {
                <a class="category-tile brand-category-tile" asp-controller="Product" asp-action="Index" asp-route-search="@brand.SearchTerm">
                    <span class="category-icon brand-category-mark" aria-hidden="true">@brand.Mark</span>
                    <span>@brand.Name</span>
                    <small>@brand.ProductCount mẫu điện thoại</small>
                </a>
            }
        </div>
    </section>

    <section class="section reveal">
        <div class="section-heading tech-heading">
            <div>
                <span class="eyebrow">Được chọn nhiều</span>
                <h2>Sản phẩm nổi bật</h2>
            </div>
            <a asp-controller="Product" asp-action="Index">Mua ngay</a>
        </div>
        <div class="product-grid">
            @foreach (var product in Model.FeaturedProducts)
            {
                <partial name="_ProductCard" model="product" />
            }
        </div>
    </section>

    @if (SprintFeatures.IsEnabled(3) && Model.PersonalizedProducts.Any())
    {
        <section class="section reveal">
            <div class="section-heading tech-heading">
                <div>
                    <span class="eyebrow">Gợi ý thông minh</span>
                    <h2>Dành riêng cho bạn</h2>
                </div>
                <a asp-controller="Product" asp-action="Index">Khám phá thêm</a>
            </div>
            <div class="product-grid">
                @foreach (var product in Model.PersonalizedProducts)
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
        </section>
    }

    @if (SprintFeatures.IsEnabled(3))
    {
    <section class="flash-sale flash-premium flash-market reveal">
        <div class="flash-market-copy">
            <div class="flash-kicker">
                <span class="flash-kicker-badge"><i data-lucide="zap" aria-hidden="true"></i> SALE</span>
                <span>Flash Sale</span>
            </div>
            <h2>Deal đáng săn, nhìn là muốn chốt.</h2>
            <p>Sản phẩm giảm giá sâu được kéo ra ngay tại trang chủ để bạn dễ chọn mức giá phù hợp.</p>
            <div class="flash-code-row">
                <div class="countdown-box flash-countdown">
                    <span>Kết thúc sau</span>
                    <strong id="countdown">00:00:00</strong>
                </div>
                @if (SprintFeatures.IsEnabled(2))
                {
                    <div class="flash-code">
                        <small>Mã hôm nay</small>
                        <strong>SALE20</strong>
                        <span>Giảm thêm tối đa 200.000 ₫</span>
                    </div>
                }
            </div>
            <a class="btn-primary flash-shop-link" asp-controller="Product" asp-action="Index" asp-route-sortBy="discount_desc">
                <i data-lucide="flame" aria-hidden="true"></i>
                Xem tất cả deal
            </a>
        </div>

        @if (mainDeal is not null)
        {
            var mainSaved = mainDeal.Price - mainDeal.SalePrice;
            <div class="flash-market-products">
                <article class="flash-main-deal">
                    <a class="flash-main-media" asp-controller="Product" asp-action="Detail" asp-route-id="@mainDeal.Id">
                        <img src="@mainDeal.PrimaryImageUrl" alt="@mainDeal.Name" loading="lazy" decoding="async" />
                        <span>-@mainDeal.DiscountPercent%</span>
                    </a>
                    <div class="flash-main-info">
                        <span class="flash-category">@mainDeal.Category?.Name</span>
                        <h3>@mainDeal.Name</h3>
                        <div class="flash-price-row">
                            <strong>@mainDeal.SalePrice.ToString("N0") ₫</strong>
                            <span>@mainDeal.Price.ToString("N0") ₫</span>
                        </div>
                        <small>Tiết kiệm @mainSaved.ToString("N0") ₫, còn @mainDeal.Stock sản phẩm</small>
                        <div class="flash-deal-actions">
                            <a class="btn-ghost flash-detail-link" asp-controller="Product" asp-action="Detail" asp-route-id="@mainDeal.Id">
                                <i data-lucide="eye" aria-hidden="true"></i>
                                Chi tiết
                            </a>
                            @if (!isAdminViewer)
                            {
                                <button class="btn-primary flash-cart-btn" type="button" data-cart-product="@mainDeal.Id">
                                    <i data-lucide="shopping-cart" aria-hidden="true"></i>
                                    Thêm giỏ
                                </button>
                            }
                        </div>
                    </div>
                </article>

                <div class="flash-mini-grid">
                    @foreach (var product in miniDeals)
                    {
                        var itemSaved = product.Price - product.SalePrice;
                        <article class="flash-mini-deal">
                            <a asp-controller="Product" asp-action="Detail" asp-route-id="@product.Id">
                                <img src="@product.PrimaryImageUrl" alt="@product.Name" loading="lazy" decoding="async" />
                            </a>
                            <div>
                                <span>-@product.DiscountPercent%</span>
                                <a asp-controller="Product" asp-action="Detail" asp-route-id="@product.Id">@product.Name</a>
                                <strong>@product.SalePrice.ToString("N0") ₫</strong>
                                <small>Rẻ hơn @itemSaved.ToString("N0") ₫</small>
                            </div>
                        </article>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="flash-empty-deals">
                <i data-lucide="tag" aria-hidden="true"></i>
                <strong>Deal mới đang được cập nhật</strong>
                <span>Quay lại danh mục sản phẩm để xem các ưu đãi hiện có.</span>
            </div>
        }
    </section>
    }

    <section class="section reveal">
        <div class="section-heading tech-heading">
            <div>
                <span class="eyebrow">Vừa lên kệ</span>
                <h2>Sản phẩm mới nhất</h2>
            </div>
        </div>
        <div class="latest-scroll product-rail latest-products-rail">
            @foreach (var product in Model.LatestProducts)
            {
                <partial name="_ProductCard" model="product" />
            }
        </div>
    </section>

    <section class="section why-us reveal">
        <div class="why-us-head">
            <span class="eyebrow">Tại sao chọn Techvora?</span>
            <h2>Mua điện thoại nhanh, rõ, đáng tin.</h2>
        </div>
        <div class="why-us-grid">
            <article class="stat-item">
                <strong class="stat-label">Giá rõ ràng</strong>
                <span>Giá bán hiển thị rõ ràng</span>
            </article>
            <article class="stat-item">
                <strong class="stat-label">Tồn kho thật</strong>
                <span>Biết còn hàng trước khi đặt</span>
            </article>
            <article class="stat-item"><strong class="stat-label">Thông tin rõ</strong><span>Thông số và tồn kho dễ kiểm tra</span></article>
            <article class="stat-item"><strong class="stat-label">Đặt hàng gọn</strong><span>Checkout địa chỉ và COD trong một luồng</span></article>
        </div>
        <p class="why-us-tagline">Techvora gom sản phẩm, giá, thông số và tồn kho vào một trải nghiệm mua sắm dễ quyết định.</p>
    </section>

    @if (SprintFeatures.IsEnabled(3))
    {
    <section class="section newsletter-cta reveal" aria-labelledby="home-deals-title">
        <div class="newsletter-copy">
            <div class="newsletter-eyebrow">
                <span class="newsletter-icon"><i data-lucide="bell" aria-hidden="true"></i></span>
                <span><span class="newsletter-live-dot" aria-hidden="true"></span>Flash sale Techvora</span>
            </div>
            <h2 id="home-deals-title">Deal đang có, chọn nhanh món phù hợp</h2>
            <p>Sản phẩm đang giảm giá được xếp theo mức ưu đãi để bạn dễ so sánh và ra quyết định.</p>
        </div>

        <div class="newsletter-action">
            <span class="newsletter-action-label">Danh sách đang sắp theo</span>
            <strong>Mức giảm cao nhất</strong>
            <a class="btn-primary newsletter-deal-link" asp-controller="Product" asp-action="Index" asp-route-sortBy="discount_desc">
                Xem flash sale
                <i data-lucide="arrow-right" aria-hidden="true"></i>
            </a>
        </div>
    </section>
    }
</section>
