@model OrderListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý đơn hàng";
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var pendingCount = Model.Orders.Count(order => order.Status == OrderStatuses.Pending);
}

<section class="admin-panel">
    <div class="panel-head">
        <h2>Bộ lọc đơn hàng</h2>
        <a class="admin-button" asp-action="ExportCsv" asp-route-status="@Model.Status" asp-route-customer="@Model.Customer" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">Export CSV</a>
    </div>
    <form class="admin-filters" method="get">
        <select name="status" aria-label="Lọc theo trạng thái">
            <option value="">Tất cả trạng thái</option>
            @foreach (var status in Model.Statuses)
            {
                <option value="@status" selected="@(Model.Status == status)">@status</option>
            }
        </select>
        <input name="customer" value="@Model.Customer" placeholder="Tên hoặc email khách hàng" aria-label="Tìm theo tên hoặc email khách hàng" />
        <input type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" aria-label="Từ ngày" />
        <input type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" aria-label="Đến ngày" />
        <button class="admin-button" type="submit">Lọc</button>
    </form>
</section>

<section class="admin-panel">
    <form action="/Admin/Order/BulkConfirm" method="post" data-bulk-orders data-confirm="Xác nhận tất cả đơn đã chọn?">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <div class="bulk-action-bar">
            <div>
                <strong>Xác nhận hàng loạt</strong>
                <span><b data-bulk-selected>0</b> đơn đã chọn · @pendingCount đơn đang chờ trên trang</span>
            </div>
            <button class="admin-button" type="submit" data-bulk-submit disabled>
                <i class="bi bi-check2-circle"></i>
                Xác nhận tất cả
            </button>
        </div>

        <table class="admin-table admin-order-table">
            <thead>
                <tr>
                    <th class="select-col"><input type="checkbox" data-bulk-check-all aria-label="Chọn tất cả đơn chờ xác nhận" @(pendingCount == 0 ? "disabled" : "") /></th>
                    <th>Mã</th>
                    <th>Khách hàng</th>
                    <th>Ngày đặt</th>
                    <th>Trạng thái</th>
                    <th>Thanh toán</th>
                    <th>Vận chuyển</th>
                    <th>Tổng tiền</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.Orders)
                {
                    var canBulkConfirm = order.Status == OrderStatuses.Pending;
                    var refundClass = order.RefundStatus == RefundStatuses.PendingManual ? "warning" : order.RefundStatus == RefundStatuses.Refunded ? "success" : "";
                    <tr class="@(canBulkConfirm ? "bulk-selectable-row" : "")">
                        <td class="select-col">
                            <input type="checkbox" name="selectedOrderIds" value="@order.Id" data-bulk-check aria-label="Chọn đơn #@order.Id" @(canBulkConfirm ? "" : "disabled") />
                        </td>
                        <td>#@order.Id</td>
                        <td>@order.User?.FullName<br /><small>@order.User?.Email</small></td>
                        <td>@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td><span class="admin-pill @(canBulkConfirm ? "warning" : "")">@order.Status</span></td>
                        <td>
                            @order.PaymentMethod<br />
                            <small>@(order.IsPaid ? "Đã thanh toán" : "Chưa thanh toán")</small><br />
                            <span class="admin-pill @refundClass">@order.RefundStatus</span>
                        </td>
                        <td>@(order.ShippingInfo?.Carrier ?? "Chưa gán")<br /><small>@(order.ShippingInfo?.TrackingCode ?? "")</small></td>
                        <td>@order.TotalAmount.ToString("N0") ₫</td>
                        <td><a class="admin-link" href="/Admin/Order/@order.Id">Chi tiết</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </form>
    @if (Model.TotalPages > 1)
    {
        <nav class="admin-pagination" aria-label="Phân trang đơn hàng">
            @if (Model.CurrentPage > 1)
            {
                <a asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-status="@Model.Status" asp-route-customer="@Model.Customer" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">Trang trước</a>
            }
            else
            {
                <span aria-disabled="true">Trang trước</span>
            }
            <strong>Trang @Model.CurrentPage / @Model.TotalPages · @Model.TotalItems đơn</strong>
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-status="@Model.Status" asp-route-customer="@Model.Customer" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">Trang sau</a>
            }
            else
            {
                <span aria-disabled="true">Trang sau</span>
            }
        </nav>
    }
</section>
