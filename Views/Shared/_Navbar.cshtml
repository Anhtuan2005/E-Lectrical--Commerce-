@using System.Security.Claims
@inject EcommerceApp.Services.ICartService CartService
@inject EcommerceApp.Data.AppDbContext Db
@{
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var cartCount = await CartService.GetCountAsync(userId, Context.Session.Id);
    var wishlistCount = string.IsNullOrWhiteSpace(userId) ? 0 : await Db.WishlistItems.CountAsync(item => item.UserId == userId);
    var categories = await Db.Categories.OrderBy(category => category.Name).ToListAsync();
    var componentNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
    {
        "CPU", "VGA", "RAM", "SSD", "Mainboard", "PSU", "Case", "Cooling"
    };
    var componentCategories = categories.Where(category => componentNames.Contains(category.Name)).ToList();
    var mainCategories = categories.Where(category => !componentNames.Contains(category.Name)).ToList();
    string CategoryIcon(string categoryName) => categoryName.ToLowerInvariant() switch
    {
        "điện thoại" => "smartphone",
        "laptop" => "laptop",
        "phụ kiện" => "headphones",
        "màn hình" => "monitor",
        "đồng hồ thông minh" => "watch",
        "cpu" => "cpu",
        "vga" => "gpu",
        "ram" => "memory-stick",
        "ssd" => "hard-drive",
        "mainboard" => "circuit-board",
        "psu" => "plug-zap",
        "case" => "box",
        "cooling" => "fan",
        _ => "boxes"
    };
}

<nav class="site-nav">
    <div class="nav-inner">
        <a class="brand brand-logo" asp-controller="Home" asp-action="Index" aria-label="Techvora">
            <partial name="_TechvoraLogo" />
        </a>

        <div class="nav-menu">
            <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
            <a class="nav-link" asp-controller="Product" asp-action="Index">Sản phẩm</a>
            <div class="nav-item">
                <a class="nav-link nav-link-with-icon" asp-controller="Product" asp-action="Index">Danh mục <i data-lucide="chevron-down" aria-hidden="true"></i></a>
                <div class="nav-dropdown nav-category-dropdown">
                    <div class="nav-category-panel">
                        <span class="nav-dropdown-label">Danh mục chính</span>
                        @foreach (var category in mainCategories)
                        {
                            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@category.Id">
                                <i data-lucide="@CategoryIcon(category.Name)" aria-hidden="true"></i>
                                <span>@category.Name</span>
                            </a>
                        }
                    </div>
                    <div class="nav-category-panel nav-category-panel-components">
                        <span class="nav-dropdown-label">Linh kiện PC</span>
                        @foreach (var category in componentCategories)
                        {
                            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@category.Id">
                                <i data-lucide="@CategoryIcon(category.Name)" aria-hidden="true"></i>
                                <span>@category.Name</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
            <a class="nav-link nav-flash nav-sale-pill nav-link-with-icon" asp-controller="Product" asp-action="Index" asp-route-sortBy="discount_desc"><i data-lucide="flame" aria-hidden="true"></i> Flash Sale</a>
            <a class="nav-link nav-link-with-icon" asp-controller="BuildPc" asp-action="Index"><i data-lucide="cpu" aria-hidden="true"></i> Build PC</a>
        </div>

        <div class="nav-actions">
            <form class="nav-search" asp-controller="Product" asp-action="Index" method="get" autocomplete="off">
                <div class="nav-search-box">
                    <input class="nav-search-input" name="search" placeholder="Tìm sản phẩm" aria-label="Tìm sản phẩm" data-search-autocomplete />
                    <div class="search-suggestions" id="searchSuggestions"></div>
                </div>
                <button class="nav-icon nav-search-btn" type="button" aria-label="Mở tìm kiếm"><i data-lucide="search" aria-hidden="true"></i></button>
            </form>
            <a class="nav-icon nav-badge-link" asp-controller="Wishlist" asp-action="Index" aria-label="Yêu thích">
                <i data-lucide="heart" aria-hidden="true"></i><em id="wishlist-count">@wishlistCount</em>
            </a>
            <a class="nav-icon nav-badge-link" asp-controller="Cart" asp-action="Index" aria-label="Giỏ hàng">
                <i data-lucide="shopping-cart" aria-hidden="true"></i><em id="cart-count">@cartCount</em>
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="avatar-menu">
                    <button class="avatar-btn" type="button" aria-label="Tài khoản"><i data-lucide="user-circle" aria-hidden="true"></i></button>
                    <div class="avatar-dropdown">
                        <span>@User.Identity.Name</span>
                        <a asp-controller="Account" asp-action="Profile">Hồ sơ cá nhân</a>
                        <a asp-controller="Order" asp-action="History">Đơn hàng của tôi</a>
                        <a asp-controller="Wishlist" asp-action="Index">Danh sách yêu thích</a>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit">Đăng xuất</button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <a class="nav-login" asp-controller="Account" asp-action="Login">Đăng nhập</a>
            }
            <button class="nav-hamburger" type="button" aria-label="Mở menu"><i data-lucide="menu" aria-hidden="true"></i></button>
        </div>
    </div>
</nav>

<div class="nav-overlay"></div>
<aside class="nav-drawer" aria-label="Menu di động">
    <div class="drawer-head">
        <a class="brand brand-logo" asp-controller="Home" asp-action="Index" aria-label="Techvora">
            <partial name="_TechvoraLogo" />
        </a>
        <button class="nav-drawer-close" type="button" aria-label="Đóng menu"><i data-lucide="x" aria-hidden="true"></i></button>
    </div>
    <a asp-controller="Home" asp-action="Index">Trang chủ</a>
    <a asp-controller="Product" asp-action="Index">Sản phẩm</a>
    <span class="drawer-section-label">Danh mục chính</span>
    @foreach (var category in mainCategories)
    {
        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@category.Id"><i data-lucide="@CategoryIcon(category.Name)" aria-hidden="true"></i> @category.Name</a>
    }
    <span class="drawer-section-label">Linh kiện PC</span>
    @foreach (var category in componentCategories)
    {
        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@category.Id"><i data-lucide="@CategoryIcon(category.Name)" aria-hidden="true"></i> @category.Name</a>
    }
    <span class="drawer-section-label">Ưu đãi</span>
    <a class="nav-flash nav-sale-pill" asp-controller="Product" asp-action="Index" asp-route-sortBy="discount_desc"><i data-lucide="flame" aria-hidden="true"></i> Flash Sale</a>
    <a asp-controller="BuildPc" asp-action="Index"><i data-lucide="cpu" aria-hidden="true"></i> Build PC</a>
    <a asp-controller="Wishlist" asp-action="Index">Yêu thích</a>
    <a asp-controller="Cart" asp-action="Index">Giỏ hàng</a>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-controller="Account" asp-action="Profile">Hồ sơ cá nhân</a>
        <a asp-controller="Order" asp-action="History">Đơn hàng</a>
        <form asp-controller="Account" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit">Đăng xuất</button>
        </form>
    }
    else
    {
        <a asp-controller="Account" asp-action="Login">Đăng nhập</a>
        <a asp-controller="Account" asp-action="Register">Đăng ký</a>
    }
</aside>
